# 复制为项目根目录 `.env` 后再填写真实值。
# 应用启动时会自动读取该文件，适用于 IDE 直接跑 main 和 `mvn spring-boot:run`。

# Spring profile，通常本地使用 dev
SPRING_PROFILES_ACTIVE=dev
APP_TIMEZONE=Asia/Shanghai

# 服务监听端口
SERVER_PORT=8081

# MySQL，库名建议保持为 PaiSmart
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/PaiSmart?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Kafka，新 Topic 会在启动时创建；已有 Topic 的分区数需确认，见 docs/kafka-consumer-reliability.md
SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SPRING_KAFKA_TOPIC_PARTITIONS=3
SPRING_KAFKA_TOPIC_REPLICATION_FACTOR=1
SPRING_KAFKA_CONSUMER_CONCURRENCY=3
SPRING_KAFKA_MAX_POLL_INTERVAL_MS=1800000

# MinIO，端口与 docs/docker-compose.yaml 一致；凭据填写该文件中的 MinIO 账号密码。
MINIO_ENDPOINT=http://localhost:19000
MINIO_PUBLIC_URL=http://localhost:19000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=uploads

# Elasticsearch，docs/docker-compose.yaml 的本地服务使用 HTTP。
# 使用 HTTPS 自签名证书时才需要 trust-all=true。
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_INSECURE_TRUST_ALL_CERTIFICATES=false

# JWT_SECRET_KEY 必须是 Base64 字符串，可用 `openssl rand -base64 32` 生成
JWT_SECRET_KEY=XeJw0yUoFDJWSNbWYFVEIXGfO8XgHrQLrIkKci5J9eA=

# 首次启动创建管理员时临时打开，创建成功后应改回 false
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_PRIMARY_ORG=default
ADMIN_BOOTSTRAP_ORG_TAGS=default,admin

# 注册模式：OPEN / INVITE_ONLY / CLOSED
APP_AUTH_REGISTRATION_MODE=INVITE_ONLY
APP_AUTH_INVITE_REQUIRED=true

# 前端来源白名单，多个域名用逗号分隔
SECURITY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# LLM 与 Embedding 提供方
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_KEY=

# Figure description 独立能力：填入百炼 API Key；未配置不影响启动。
# API Key 和 endpoint 必须属于相同地域；也可使用 DASHSCOPE_API_KEY 环境变量。
FIGURE_DESCRIPTION_API_KEY=
FIGURE_DESCRIPTION_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
FIGURE_DESCRIPTION_MODEL=qwen3-vl-flash
FIGURE_DESCRIPTION_REQUEST_TIMEOUT=90s
FIGURE_DESCRIPTION_MAX_IMAGE_BYTES=10485760
FIGURE_DESCRIPTION_MAX_LENGTH=1000
FIGURE_DESCRIPTION_MAX_CONTEXT_CHARS=12000
FIGURE_DESCRIPTION_MAX_RESPONSE_BYTES=65536

# PDF 主链使用 PP-StructureV3 官方异步 API。
# 填好 PADDLEOCR_ACCESS_TOKEN 后再将 PADDLEOCR_ENABLED 改为 true。
PADDLEOCR_ENABLED=false
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
PADDLEOCR_ACCESS_TOKEN=

# 本地联调关闭启动时自动解析内置知识库文档，只处理手动上传的文件。
KNOWLEDGE_BOOTSTRAP_ENABLED=false

# 日志等级，排障时可临时改为 DEBUG
LOG_LEVEL_APP=INFO

# 前端部署
DEPLOY_SERVER_HOST=
DEPLOY_SERVER_USER=root
DEPLOY_SERVER_KEY=/absolute/path/to/paicoding.pem
DEPLOY_TARGET_DIR=/home/www/PaiSmart-Front
DEPLOY_HEALTHCHECK_URL=https://smart.paicoding.com
DEPLOY_HEALTHCHECK_TIMEOUT=15

# 微信支付相关配置
WX_PAY_ENABLE=false
WX_PAY_APP_ID=
WX_PAY_MERCHANT_ID=
WX_PAY_PRIVATE_KEY=
WX_PAY_MERCHANT_SERIAL_NUMBER=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://smart.paicoding.com/api/v1/recharge/pay-callback
WX_PAY_REFUND_NOTIFY_URL=https://smart.paicoding.com/api/v1/recharge/refund-callback

# LiteParse PDF 解析
# FILE_PARSING_LITEPARSE_COMMAND 不是必填项；如果后端进程能直接执行
# `lit --help`，默认值 `lit` 就够用。
# 生产环境建议配置为 `which lit` 查到的绝对路径，避免 systemd/Docker/IDE
# 的 PATH 和当前 shell 不一致。
FILE_PARSING_LITEPARSE_COMMAND=lit

# OCR 可走内置 Tesseract，也可走 PaiSmart 内置的阿里云 Adapter。
# 普通带文本层的 PDF 可先关闭 OCR；需要识别图片文字时再开启。
FILE_PARSING_LITEPARSE_OCR_ENABLED=false
# 内置 Tesseract 可用 chi_sim；接入阿里云 Adapter 时继续使用 chi_sim 即可。
FILE_PARSING_LITEPARSE_OCR_LANGUAGE=chi_sim
FILE_PARSING_LITEPARSE_DPI=300

# 阿里云 OCR 统一识别（RecognizeAllText）配置。
# 默认 Type=Advanced，即通用文字识别高精版，适合 PDF 内嵌截图、聊天记录、图片文字进入 Embedding。
ALIYUN_OCR_ENABLED=false
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_TYPE=Advanced
ALIYUN_OCR_OUTPUT_COORDINATE=points
ALIYUN_OCR_OUTPUT_ORICOORD=true
ALIYUN_OCR_OUTPUT_ROW=false
ALIYUN_OCR_OUTPUT_PARAGRAPH=false
ALIYUN_OCR_OUTPUT_TABLE=false
ALIYUN_OCR_CALLBACK_TOKEN=

# Tesseract 语言包目录，目录下应包含 eng.traineddata 和 chi_sim.traineddata。
# PaiSmart 会把该值作为 TESSDATA_PREFIX 环境变量传给 LiteParse 子进程。
# macOS 示例：/Users/yourname/Library/Application Support/tesseract-rs/tessdata
# Linux 示例：/usr/local/share/tessdata
# Windows 示例：C:/Users/yourname/AppData/Roaming/tesseract-rs/tessdata
FILE_PARSING_LITEPARSE_TESSDATA_PATH=
